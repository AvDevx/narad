# Environment
NODE_ENV=development

# Server
PORT=8080

# Admin Dashboard
# Secret key for accessing /health/dashboard
# IMPORTANT: Change this in production!
ADMIN_SECRET=dev-admin-secret-change-in-production

# Kafka Configuration
KAFKA_CLIENT_ID=narad
KAFKA_BROKERS=localhost:9092

# Kafka Authentication (Optional - for Production)
KAFKA_SSL=false
KAFKA_SASL_MECHANISM=plain
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TLS=false
